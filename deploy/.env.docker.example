# Archivo .env para Docker Compose
# Copia este archivo a .env en la carpeta deploy/ para usar
# cp .env.docker.example .env

# === Configuración de Flask-Mail ===
# Deja estos valores vacíos para modo desarrollo (correos en consola)
# O configúralos con tus credenciales para envío real

# Gmail SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=

# Para Outlook:
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USE_TLS=True
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=
