# Configuración de Flask-Mail
# Para usar Gmail, necesitas:
# 1. Habilitar "Contraseñas de aplicación" en tu cuenta de Google
# 2. Usar la contraseña de aplicación generada, NO tu contraseña normal

# Para Gmail con SMTP
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=tu_email@gmail.com
MAIL_PASSWORD=tu_contraseña_de_aplicacion
MAIL_DEFAULT_SENDER=tu_email@gmail.com

# Para otro servidor SMTP (ej: Outlook, SendGrid, etc)
# MAIL_SERVER=smtp.office365.com
# MAIL_PORT=587
# MAIL_USERNAME=tu_email@outlook.com
# MAIL_PASSWORD=tu_contraseña

# Si no configuras estas variables, los correos se mostrarán en consola (útil para desarrollo)
